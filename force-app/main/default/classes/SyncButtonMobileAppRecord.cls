public class SyncButtonMobileAppRecord  implements Database.Batchable<sObject>, Database.AllowsCallouts {
  
    public String objectApiName;
 
    public SyncButtonMobileAppRecord(String objectApiName) {
     
        this.objectApiName = objectApiName;
    }

    public Database.QueryLocator start(Database.BatchableContext context) {
        
          system.debug('ObjectApiName: '+ObjectApiName);
        
         // Get all field names for the sObject
        List<String> fieldNames = new List<String>();
        for (Schema.SObjectField field : Schema.getGlobalDescribe().get(objectApiName).getDescribe().fields.getMap().values()) {
            fieldNames.add(field.getDescribe().getName());
        }
        System.debug('fieldNames : ' + fieldNames);
        
         String query = 'SELECT ' + String.join(fieldNames, ',') + ' FROM '+ ObjectApiName;

            System.debug('Query ----------- ' + query);
            return Database.getQueryLocator(query);
    }
    
    
    public void execute(Database.BatchableContext context, List<sObject> batch) {
        
         // Get all field names for the sObject
        List<String> fieldNames = new List<String>();
        for (Schema.SObjectField field : Schema.getGlobalDescribe().get(objectApiName).getDescribe().fields.getMap().values()) {
            fieldNames.add(field.getDescribe().getName());
        }
        System.debug('fieldNames : ' + fieldNames);
        
           system.debug('batch: '+batch);
           system.debug('batch size: '+batch.size());
        
        //store all the data of MobileApp including null values
           List<sObject> MobileAppResultRecord = new List<sObject>();
        
         for (sObject MobileAppRecord : batch) {            
                // Check for missing fields
                Map<String, Object> missingFieldValues = new Map<String, Object>();
                for (String fieldName : fieldNames) {
                    if (!MobileAppRecord.getPopulatedFieldsAsMap().containsKey(fieldName)) {
                        missingFieldValues.put(fieldName, null);
                        missingFieldValues.remove('LastActivityDate'); // Remove the system generated fields
                        missingFieldValues.remove('UserRecordAccessId');
                        missingFieldValues.remove('ConnectionReceivedId');
                        missingFieldValues.remove('ConnectionSentId');
                        system.debug('After remove: '+missingFieldValues);  
                    }
                }
             	  // Add missing fields to the MobileApp record list
            for (String fieldName : missingFieldValues.keySet()) {
                Schema.DescribeFieldResult fieldDesc = MobileAppRecord.getSobjectType().getDescribe().fields.getMap().get(fieldName).getDescribe();
             
                //Check for only updatable field which are not generated by system
                if (fieldDesc.isUpdateable()) {
                    MobileAppRecord.put(fieldName, missingFieldValues.get(fieldName));                    
                    system.debug('missing fields--'+fieldName);
                    system.debug('fields value--'+missingFieldValues.get(fieldName));
                }
            }
            MobileAppResultRecord.add(MobileAppRecord);
       
          }
            // Send the data to an external API
            Http http = new Http();
            HttpRequest req = new HttpRequest();
            req.setTimeout(60000); // Timeout in milliseconds
            req.setMethod('POST');
            req.setEndpoint('https://ny67869sad.execute-api.us-east-2.amazonaws.com/production/saveRecords?objectName='+ObjectApiName);
            req.setHeader('Content-Type', 'application/json');
            req.setHeader('Authorization', 'REPLACE_WITH_AWS_AUTH_HEADER');
            String Test = JSON.serialize(MobileAppResultRecord);
            system.debug('Test--: '+Test);
            req.setBody(Test);
            HttpResponse response = http.send(req);
             if (response.getStatusCode() == 200) {
                    System.debug(response.getStatusCode() + ' ' + response.getStatus());
                    System.debug(response.getBody());
                    }else {
                        System.debug(response.getBody());					
                    }
            System.debug(response.getBody());
        
        
    }
    
     public void finish(Database.BatchableContext context) {
        // No action required in this example
    }
    
    
}